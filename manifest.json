{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "LobbyFX",
  "version": "0.6.0",
  "description": "__MSG_extDesc__",
  "default_locale": "uk",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LobbyFX"
  },
  "options_page": "app.html",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "idle",
    "notifications"
  ],
  "host_permissions": [
    "https://www.faceit.com/*",
    "https://tenor.com/*",
    "https://giphy.com/*",
    "https://www.youtube.com/*",
    "https://www.myinstants.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.faceit.com/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.faceit.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sounds/*",
        "themes/*"
      ],
      "matches": [
        "https://www.faceit.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}